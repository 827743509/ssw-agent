SSW_BASE_URL=https://api.deepseek.com
SSW_MODEL=deepseek-v4-pro

#LANGSMITH
#LANGSMITH_API_KEY=ssw_5cae7cd751c18c57023bdcff58c2af7fd1dd763abd0496a5
#LANGSMITH_TRACING=true
#LANGSMITH_PROJECT=ssw-agent
