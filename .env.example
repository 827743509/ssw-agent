LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=ssw-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Local workspace
SSW_WEB_HOST=127.0.0.1
SSW_WEB_PORT=8000
SSW_AGENT_PROTOCOL_HOST=127.0.0.1
SSW_AGENT_PROTOCOL_PORT=2024
SSW_AGENT_PROTOCOL_URL=http://127.0.0.1:2024
REDIS_URL=redis://127.0.0.1:6379/0

# Docker Compose 可选端口与数据库账号
FRONTEND_PORT=9001
BACKEND_PORT=8000
AGENT_PROTOCOL_PORT=2024
REDIS_PORT=6379
MONGODB_PORT=27017
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9002
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=123456


#MONGODB
LS_MONGODB_URI=mongodb://root:123456@localhost:27017/langgraph?authSource=admin&replicaSet=rs0


# ===== PostgreSQL（docker-compose 与后端共用）=====
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag_kb
POSTGRES_PORT=5432

# 后端连接串：注意使用 asyncpg driver
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag_kb

# ===== minio =====
OSS_ORIGINS=localhost:9000
OSS_ACCESS_KEY=VRDCTCVBTVDLX0YJJHM3
OSS_SECRET_KEY=YotSomHBA5E2zPuqeqXVb65GyHWzRWEUw44aZ+Wc
OSS_BUCKET=ssw-bucket

CORS_ORIGINS=http://localhost:9001


# ===== Embedding（DashScope OpenAI 兼容协议）=====
# 申请 key：https://bailian.console.aliyun.com/ → API-KEY
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10

# ===== HuggingFace 镜像（Docling 模型下载）=====
# 国内网络无法直连 huggingface.co 时，启用此镜像加速模型下载
HF_ENDPOINT=https://hf-mirror.com

# ===== 文档上传与切分 =====
UPLOAD_MAX_SIZE_MB=50
CHUNK_SIZE=600
CHUNK_OVERLAP=60

# Celery broker / backend 各占一个 db，避免与应用缓存键互相干扰
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

QUERY_ROUTE_ENABLED=False
MULTI_QUERY_COUNT=3


# ===== 检索与问答 =====
RETRIEVAL_TOP_K=5
# Top-K 最高相似度低于此阈值则拒答（cosine similarity，0-1）
RETRIEVAL_MIN_SCORE=0.6
CHAT_HISTORY_WINDOW=5

# ===== 混合检索 =====
# 每路（向量 / 关键词）召回数量；设计文档建议候选 20-50
# 取 20 兼顾召回率与 RRF 融合开销
RETRIEVAL_RECALL_TOP_K=20
# RRF 平滑常数，业界默认 60；越小越偏向高排名条目
RRF_K=60


# ===== Reranker =====
# 关掉后 rerank 节点直接透传，作为有/无精排的对比开关
RERANK_ENABLED=True
RERANK_MODEL=qwen3-rerank
# DashScope rerank 端点，不是标准 OpenAI API
RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1/reranks
# 留空则自动复用 CHAT_API_KEY
RERANK_API_KEY=
# rerank Top1 相关度低于此阈值时拒答（qwen3-rerank score ∈ [0, 1]）
RERANK_MIN_SCORE=0.3
RERANK_TIMEOUT=8

# ===== Agentic RAG =====
# 关掉后图退化为单轮检索，作为单轮 vs agent 循环的对比开关
AGENT_LOOP_ENABLED=True
# 最大检索轮次（含首轮）。LLM 决策最多触发 max_rounds-1 次再检索，避免循环调用
AGENT_MAX_ROUNDS=3


# ===== 语义缓存 =====
# 关掉后 chat 主链路完全跳过缓存查询/写入
SEMANTIC_CACHE_ENABLED=True
# 单条缓存最大存活时间（秒），默认 1 小时
SEMANTIC_CACHE_TTL_SECONDS=3600
# 余弦相似度阈值：query 与缓存问题向量相似度 ≥ 此值且权限范围一致才视为命中
SEMANTIC_CACHE_MIN_SIMILARITY=0.92
